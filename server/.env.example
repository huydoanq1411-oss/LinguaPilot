# Prisma dùng URL này để kết nối tới cổng PostgreSQL được publish trên máy host.
DATABASE_URL=postgresql://linguapilot:replace-with-a-local-password@localhost:5434/linguapilot?schema=public

# Dùng chuỗi bí mật ngẫu nhiên tối thiểu 16 ký tự; JWT có thời hạn 7 ngày.
JWT_SECRET=replace-with-a-random-secret-at-least-16-characters

# Có thể liệt kê nhiều origin frontend, phân cách bằng dấu phẩy.
CLIENT_ORIGIN=http://localhost:5173
PORT=3000
